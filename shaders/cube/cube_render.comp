#version 460

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D sourceImage;
layout(set = 0, binding = 1) uniform writeonly image2D outputImage;
layout(std140, set = 0, binding = 2) uniform CubeParameters {
    vec4 view;             // yaw, pitch, viewport width, viewport height
    vec4 source;           // source width, source height, sample step, HDR flag
    vec4 rangeMinimum;     // first, second, vertical
    vec4 rangeMaximum;     // first, second, vertical
    uvec4 meta;            // cube space
    uvec4 labelLengths0;
    uvec4 labelLengths1;
    uvec4 labelCharacters[36];
} parameters;
layout(std430, set = 0, binding = 3) buffer PointPixels {
    uint values[];
} pointPixels;
layout(push_constant) uniform RenderPass {
    uint pass;
} renderPass;

const vec3 background = vec3(6.0, 9.0, 12.0) / 255.0;
const vec3 edgeColor = vec3(70.0, 90.0, 100.0) / 255.0;
const vec3 axisColors[3] = vec3[3](
    vec3(255.0, 75.0, 75.0) / 255.0,
    vec3(75.0, 220.0, 120.0) / 255.0,
    vec3(75.0, 130.0, 255.0) / 255.0);

float decodeDisplayValue(float value, bool hdr) {
    if (!hdr) {
        return value <= 0.04045 ? value / 12.92 :
            pow((value + 0.055) / 1.055, 2.4);
    }
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 32.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    const float p = pow(value, 1.0 / m2);
    return pow(max(p - c1, 0.0) / (c2 - c3 * p), 1.0 / m1);
}

vec3 linearRgbToXyz(vec3 rgb, bool hdr) {
    if (hdr) {
        return vec3(
            0.6369580483 * rgb.r + 0.1446169036 * rgb.g + 0.1688809752 * rgb.b,
            0.2627002120 * rgb.r + 0.6779980715 * rgb.g + 0.0593017165 * rgb.b,
            0.0280726930 * rgb.g + 1.0609850577 * rgb.b);
    }
    return vec3(
        0.4123907993 * rgb.r + 0.3575843394 * rgb.g + 0.1804807884 * rgb.b,
        0.2126390059 * rgb.r + 0.7151686788 * rgb.g + 0.0721923154 * rgb.b,
        0.0193308187 * rgb.r + 0.1191947798 * rgb.g + 0.9505321522 * rgb.b);
}

float lightnessFunction(float value) {
    const float epsilon = 216.0 / 24389.0;
    return value > epsilon ? pow(value, 1.0 / 3.0) :
        (841.0 / 108.0) * value + 4.0 / 29.0;
}

vec3 xyzToJzAzBz(vec3 xyz, bool hdr) {
    xyz *= hdr ? 10000.0 : 203.0;
    const float xp = 1.15 * xyz.x - 0.15 * xyz.z;
    const float yp = 0.66 * xyz.y + 0.34 * xyz.x;
    const float lp = 0.41478972 * xp + 0.579999 * yp + 0.014648 * xyz.z;
    const float mp = -0.20151 * xp + 1.120649 * yp + 0.0531008 * xyz.z;
    const float sp = -0.0166008 * xp + 0.2648 * yp + 0.6684799 * xyz.z;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 128.0;
    const float c3 = 2392.0 / 128.0;
    const float n = 2610.0 / 16384.0;
    const float p = 1.7 * 2523.0 / 32.0;
    vec3 power = pow(max(vec3(lp, mp, sp), vec3(0.0)) / 10000.0, vec3(n));
    vec3 lms = pow((vec3(c1) + c2 * power) / (vec3(1.0) + c3 * power), vec3(p));
    const float iz = 0.5 * (lms.x + lms.y);
    const float az = 3.524 * lms.x - 4.066708 * lms.y + 0.542708 * lms.z;
    const float bz = 0.199076 * lms.x + 1.096799 * lms.y - 1.295875 * lms.z;
    const float jz = 0.44 * iz / (1.0 - 0.56 * iz) - 1.6295499532821566e-11;
    return vec3(bz, az, jz);
}

vec3 rawCoordinates(uint space, vec3 displayRgb, bool hdr) {
    if (space == 0u) return displayRgb;
    const vec3 linear = vec3(
        decodeDisplayValue(displayRgb.r, hdr),
        decodeDisplayValue(displayRgb.g, hdr),
        decodeDisplayValue(displayRgb.b, hdr));
    const vec3 xyz = linearRgbToXyz(linear, hdr);
    if (space == 1u) {
        const float sum = xyz.x + xyz.y + xyz.z;
        const vec2 xy = sum > 0.0 ? xyz.xy / sum : vec2(0.0);
        return vec3(xy.y, xy.x, xyz.y);
    }
    if (space == 2u) {
        const float d = xyz.x + 15.0 * xyz.y + 3.0 * xyz.z;
        return d > 0.0 ? vec3(6.0 * xyz.y / d, 4.0 * xyz.x / d, xyz.y) : vec3(0.0);
    }
    if (space == 3u) {
        const float whiteD = 0.9504559 + 15.0 + 3.0 * 1.0890578;
        const float whiteU = 4.0 * 0.9504559 / whiteD;
        const float whiteV = 9.0 / whiteD;
        const float d = xyz.x + 15.0 * xyz.y + 3.0 * xyz.z;
        const float u = d > 0.0 ? 4.0 * xyz.x / d : whiteU;
        const float v = d > 0.0 ? 9.0 * xyz.y / d : whiteV;
        const float l = 116.0 * lightnessFunction(xyz.y) - 16.0;
        return vec3(13.0 * l * (v - whiteV), 13.0 * l * (u - whiteU), l);
    }
    const float fx = lightnessFunction(xyz.x / 0.9504559);
    const float fy = lightnessFunction(xyz.y);
    const float fz = lightnessFunction(xyz.z / 1.0890578);
    const vec3 lab = vec3(200.0 * (fy - fz), 500.0 * (fx - fy), 116.0 * fy - 16.0);
    if (space == 4u) return lab;
    if (space == 5u) {
        const float chroma = length(lab.xy);
        float hue = chroma > 1.0e-4 ? degrees(atan(lab.x, lab.y)) : 0.0;
        if (hue < 0.0) hue += 360.0;
        return vec3(hue, chroma, lab.z);
    }
    const vec3 jz = xyzToJzAzBz(xyz, hdr);
    if (space == 6u) return jz;
    const float chroma = length(jz.xy);
    float hue = chroma > 1.0e-7 ? degrees(atan(jz.x, jz.y)) : 0.0;
    if (hue < 0.0) hue += 360.0;
    return vec3(hue, chroma, jz.z);
}

vec3 normalizeCoordinates(vec3 value) {
    const vec3 span = parameters.rangeMaximum.xyz - parameters.rangeMinimum.xyz;
    return clamp((value - parameters.rangeMinimum.xyz) /
                 max(span, vec3(1.0e-20)), 0.0, 1.0);
}

vec2 projectCube(vec3 value) {
    const float halfHorizontal = 0.4330127;
    const float inverseSqrtTwo = 0.7071068;
    vec3 centered = value - 0.5;
    const float sinYaw = sin(parameters.view.x);
    const float cosYaw = cos(parameters.view.x);
    const float sinPitch = sin(parameters.view.y);
    const float cosPitch = cos(parameters.view.y);
    const float yawFirst = cosYaw * centered.x - sinYaw * centered.y;
    const float yawSecond = sinYaw * centered.x + cosYaw * centered.y;
    const float pitchDot = (yawFirst + yawSecond) * inverseSqrtTwo;
    const float pitchFirst = yawFirst * cosPitch + centered.z * inverseSqrtTwo * sinPitch +
        pitchDot * inverseSqrtTwo * (1.0 - cosPitch);
    const float pitchSecond = yawSecond * cosPitch - centered.z * inverseSqrtTwo * sinPitch +
        pitchDot * inverseSqrtTwo * (1.0 - cosPitch);
    const float pitchVertical = centered.z * cosPitch +
        (yawSecond - yawFirst) * inverseSqrtTwo * sinPitch;
    return vec2(0.5 + (pitchFirst + pitchSecond) * halfHorizontal,
                0.5 + 0.25 * (pitchFirst - pitchSecond) + 0.5 * pitchVertical);
}

vec2 screenPoint(vec3 value) {
    const float size = max(1.0, min(parameters.view.z, parameters.view.w) - 144.0);
    const float left = (parameters.view.z - size) * 0.5;
    const float bottom = (parameters.view.w + size) * 0.5;
    const vec2 projected = projectCube(value);
    return vec2(left + projected.x * size, bottom - projected.y * size);
}

float segmentDistance(vec2 point, vec2 start, vec2 finish) {
    const vec2 delta = finish - start;
    const float lengthSquared = dot(delta, delta);
    const float t = lengthSquared > 0.0
        ? clamp(dot(point - start, delta) / lengthSquared, 0.0, 1.0) : 0.0;
    return length(point - (start + delta * t));
}

uint fontRow(uint character, uint row) {
    if (character == 48u) { const uint r[7] = uint[7](6, 9, 9, 9, 9, 9, 6); return r[row]; }
    if (character == 49u) { const uint r[7] = uint[7](2, 6, 2, 2, 2, 2, 7); return r[row]; }
    if (character == 50u) { const uint r[7] = uint[7](6, 9, 1, 2, 4, 8, 15); return r[row]; }
    if (character == 51u) { const uint r[7] = uint[7](14, 1, 1, 6, 1, 1, 14); return r[row]; }
    if (character == 52u) { const uint r[7] = uint[7](2, 6, 10, 10, 15, 2, 2); return r[row]; }
    if (character == 53u) { const uint r[7] = uint[7](15, 8, 8, 14, 1, 1, 14); return r[row]; }
    if (character == 54u) { const uint r[7] = uint[7](6, 8, 8, 14, 9, 9, 6); return r[row]; }
    if (character == 55u) { const uint r[7] = uint[7](15, 1, 2, 2, 4, 4, 4); return r[row]; }
    if (character == 56u) { const uint r[7] = uint[7](6, 9, 9, 6, 9, 9, 6); return r[row]; }
    if (character == 57u) { const uint r[7] = uint[7](6, 9, 9, 7, 1, 1, 6); return r[row]; }
    if (character == 45u) return row == 3u ? 15u : 0u;
    if (character == 43u) return row == 3u ? 15u : (row >= 1u && row <= 5u ? 2u : 0u);
    if (character == 46u) return row == 6u ? 2u : 0u;
    if (character == 42u) { const uint r[7] = uint[7](0, 10, 4, 14, 4, 10, 0); return r[row]; }
    if (character == 65u || character == 97u) { const uint r[7] = uint[7](6, 9, 9, 15, 9, 9, 9); return r[row]; }
    if (character == 66u || character == 98u) { const uint r[7] = uint[7](14, 9, 9, 14, 9, 9, 14); return r[row]; }
    if (character == 67u) { const uint r[7] = uint[7](7, 8, 8, 8, 8, 8, 7); return r[row]; }
    if (character == 71u) { const uint r[7] = uint[7](7, 8, 8, 11, 9, 9, 7); return r[row]; }
    if (character == 74u) { const uint r[7] = uint[7](3, 1, 1, 1, 9, 9, 6); return r[row]; }
    if (character == 76u) { const uint r[7] = uint[7](8, 8, 8, 8, 8, 8, 15); return r[row]; }
    if (character == 82u) { const uint r[7] = uint[7](14, 9, 9, 14, 10, 9, 9); return r[row]; }
    if (character == 89u) { const uint r[7] = uint[7](9, 9, 9, 6, 2, 2, 2); return r[row]; }
    if (character == 101u) { const uint r[7] = uint[7](0, 0, 6, 9, 15, 8, 7); return r[row]; }
    if (character == 104u) { const uint r[7] = uint[7](8, 8, 14, 9, 9, 9, 9); return r[row]; }
    if (character == 117u) { const uint r[7] = uint[7](0, 0, 9, 9, 9, 11, 5); return r[row]; }
    if (character == 118u) { const uint r[7] = uint[7](0, 0, 9, 9, 9, 6, 6); return r[row]; }
    if (character == 120u) { const uint r[7] = uint[7](0, 0, 9, 6, 6, 9, 9); return r[row]; }
    if (character == 121u) { const uint r[7] = uint[7](0, 0, 9, 9, 7, 1, 6); return r[row]; }
    if (character == 122u) { const uint r[7] = uint[7](0, 0, 15, 2, 4, 8, 15); return r[row]; }
    return 0u;
}

uint labelLength(uint label) {
    return label < 4u ? parameters.labelLengths0[label]
                      : parameters.labelLengths1[label - 4u];
}

uint labelCharacter(uint label, uint character) {
    const uint index = label * 24u + character;
    return parameters.labelCharacters[index / 4u][index % 4u];
}

vec2 labelAnchor(uint label, uint length) {
    const float scale = 2.0;
    const vec2 origin = screenPoint(vec3(0.0));
    vec2 anchor;
    if (label < 3u) {
        const float direction = origin.y < parameters.view.w * 0.5 ? 1.0 : -1.0;
        anchor = origin + vec2(4.0, direction * (4.0 + 18.0 * float(label)));
    } else {
        const uint vertex = label == 3u ? 1u : (label == 4u ? 2u : 4u);
        anchor = screenPoint(vec3(float(vertex & 1u), float((vertex >> 1u) & 1u),
                                  float((vertex >> 2u) & 1u))) + vec2(4.0, -8.0);
    }
    const float textWidth = max(1.0, float(length) * 5.0 * scale - scale);
    return clamp(anchor, vec2(2.0),
                 max(vec2(2.0), parameters.view.zw - vec2(textWidth + 2.0, 16.0)));
}

bool overlayColorAt(vec2 pixel, out vec3 color) {
    const int scale = 1;
    for (uint label = 0u; label < 6u; ++label) {
        const uint length = labelLength(label);
        const vec2 anchor = labelAnchor(label, length);
        const ivec2 local = ivec2(floor(pixel - anchor));
        const int textWidth = int(length) * 5 * scale - scale;
        if (local.x < -1 || local.y < -1 || local.x > textWidth || local.y > 7 * scale) continue;
        color = background;
        if (local.x < 0 || local.y < 0 || local.x >= textWidth || local.y >= 7 * scale) {
            return true;
        }
        const uint characterIndex = uint(local.x) / uint(5 * scale);
        const uint cellColumn = uint(local.x) % uint(5 * scale);
        if (cellColumn >= uint(4 * scale)) return true;
        const uint column = cellColumn / uint(scale);
        const uint row = uint(local.y) / uint(scale);
        const uint bits = fontRow(labelCharacter(label, characterIndex), row);
        if ((bits & (1u << (3u - column))) != 0u) color = axisColors[label % 3u];
        return true;
    }
    for (uint vertex = 0u; vertex < 8u; ++vertex) {
        for (uint axis = 0u; axis < 3u; ++axis) {
            const uint other = vertex ^ (1u << axis);
            if (vertex < other && segmentDistance(pixel,
                    screenPoint(vec3(float(vertex & 1u), float((vertex >> 1u) & 1u),
                                     float((vertex >> 2u) & 1u))),
                    screenPoint(vec3(float(other & 1u), float((other >> 1u) & 1u),
                                     float((other >> 2u) & 1u)))) <= 0.75) {
                color = edgeColor;
                if (vertex == 0u) color = axisColors[axis];
                return true;
            }
        }
    }
    return false;
}

uint packPointColor(vec3 color) {
    const uvec3 rgb = uvec3(round(clamp(color, 0.0, 1.0) * 127.0));
    const uint luminance = uint(round(clamp(dot(color, vec3(0.2126, 0.7152, 0.0722)),
                                               0.0, 1.0) * 511.0));
    return 0x80000000u | (luminance << 21u) |
           (rgb.r << 14u) | (rgb.g << 7u) | rgb.b;
}

vec3 unpackPointColor(uint packed) {
    return vec3((packed >> 14u) & 127u,
                (packed >> 7u) & 127u,
                packed & 127u) / 127.0;
}

void main() {
    const ivec2 invocation = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 outputSize = ivec2(parameters.view.zw);
    if (renderPass.pass == 0u || renderPass.pass == 2u) {
        if (any(greaterThanEqual(invocation, outputSize))) return;
        if (renderPass.pass == 0u) {
            pointPixels.values[uint(invocation.y * outputSize.x + invocation.x)] = 0u;
            imageStore(outputImage, invocation, vec4(background, 1.0));
            return;
        }
        const uint point = pointPixels.values[uint(invocation.y * outputSize.x + invocation.x)];
        vec3 color = unpackPointColor(point);
        if (point != 0u) imageStore(outputImage, invocation, vec4(color, 1.0));
        if (overlayColorAt(vec2(invocation) + 0.5, color)) {
            imageStore(outputImage, invocation, vec4(color, 1.0));
        }
        return;
    }

    const int step = max(1, int(parameters.source.z));
    const ivec2 sourcePixel = invocation * step;
    const ivec2 sourceSize = ivec2(parameters.source.xy);
    if (any(greaterThanEqual(sourcePixel, sourceSize))) return;
    const vec3 displayRgb = texelFetch(sourceImage, sourcePixel, 0).rgb;
    const vec3 coordinate = normalizeCoordinates(
        rawCoordinates(parameters.meta.x, displayRgb, parameters.source.w != 0.0));
    const ivec2 target = ivec2(round(screenPoint(coordinate)));
    for (int y = 0; y < 1; ++y) {
        for (int x = 0; x < 1; ++x) {
            const ivec2 pixel = target + ivec2(x, y);
            if (all(greaterThanEqual(pixel, ivec2(0))) && all(lessThan(pixel, outputSize))) {
                atomicMax(pointPixels.values[uint(pixel.y * outputSize.x + pixel.x)],
                          packPointColor(displayRgb));
            }
        }
    }
}
